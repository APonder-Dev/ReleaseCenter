// ReleaseCenter database schema.
//
// This is the foundation-phase placeholder: only the generator and
// datasource are defined. The full domain model (User, Organization,
// Membership, Role, GitHubInstallation, Repository, RepositorySyncState,
// ReleasePolicy, ReleaseCandidate, ReleaseChange, ReleaseApproval,
// ReleasePublication, ReleaseArtifact, WebhookEvent, BackgroundJob,
// NotificationEndpoint, AuditEvent) is defined in Phase 2 (Database Design).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
