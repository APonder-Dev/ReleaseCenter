{
  "name": "@releasecenter/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations, and database client.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
